<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add post</title>
    <link rel="stylesheet" href="/style_new.css">
</head>
<body>
    <h1>Add new POST</h1>
    <form  method="post" action="/posts">
        <div class="username">
            <label for="username">Enter Username:</label>
            <input type="text" placeholder="Enter Your Username" id="username" name="username">
        </div>
        <div class="content">
            <label for="content">Enter Content:</label>
            <input type="text" placeholder="Enter Your Content" id="content" name="content">
        </div>
        <div class="buttons">
            <button type="submit" class="post">Post this content</button>
            <button type="reset" class="reset">Reset the content</button>
        </div>
        
        
    </form>
</body>
</html>