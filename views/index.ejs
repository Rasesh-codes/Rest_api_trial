<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rest_class</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora Posts</h1>
    <% for(post of posts) { %>
        <div>
            <h2 class="username">@<%= post.username %></h2>
            <h2 class="content"><%= post.content %></h2>
            <br>
            <a href="http://localhost:8080/posts/<%= post.id %>">Show Full Post</a>
            <a href="http://localhost:8080/posts/<%= post.id %>/edit">Edit Post</a>
        </div>
        <% } %>
    <br>
    <br>
    <div class="newpost-button">
        <a href="http://localhost:8080/posts/new">Create New Post</a>
    </div>
    
</body>
</html>